<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="TurboXml" Version="2.0.2" />
    <ProjectReference Include="..\sizoscope-cli\sizoscope-cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\sizoscope\MstatData.cs" Link="Production\MstatData.cs" />
    <Compile Include="..\sizoscope\MstatData.Cache.cs" Link="Production\MstatData.Cache.cs" />
    <Compile Include="..\sizoscope\MstatData.Diff.cs" Link="Production\MstatData.Diff.cs" />
    <Compile Include="..\sizoscope\MstatData.Enumeration.cs" Link="Production\MstatData.Enumeration.cs" />
    <Compile Include="..\sizoscope\MstatData.Graph.cs" Link="Production\MstatData.Graph.cs" />
    <Compile Include="..\sizoscope\MstatData.ObjectModel.cs" Link="Production\MstatData.ObjectModel.cs" />
    <Compile Include="..\sizoscope\InputFileHelper.cs" Link="Production\InputFileHelper.cs" />
    <Compile Include="..\sizoscope\Dependency*.cs" Exclude="..\sizoscope\DependencyGraphToolbar.cs" Link="Production\%(Filename)%(Extension)" />
    <Compile Include="..\sizoscope\FileSizeFormatter.cs" Link="Production\FileSizeFormatter.cs" />
  </ItemGroup>
</Project>
